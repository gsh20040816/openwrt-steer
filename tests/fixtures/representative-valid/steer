config steer 'main'
	option schema_version '3'
	option enabled '0'
	option router_proxy '1'
	list managed_zone 'lan'
	option tproxy_port '1042'
	option dns_port '1053'
	option dns_upstream_mark '256'
	option routing_mark '129'
	option tproxy_mark '128'
	option mark_mask '255'
	option route_table '80'
	option rule_priority '1024'
	option log_level 'warn'

config bootstrap 'bootstrap'
	option protocol 'udp'
	option server '1.1.1.1'
	option server_port '53'
	option strategy 'prefer_ipv4'

config node 'reality_node'
	option type 'vless'
	option server 'reality.example.com'
	option server_port '443'
	option uuid '00000000-0000-4000-8000-000000000001'
	option flow 'xtls-rprx-vision'
	option packet_encoding 'xudp'
	option tls_server_name 'www.example.com'
	option reality_public_key 'bm90LWEtcmVhbC1wdWJsaWMta2V5LWZvci10ZXN0cyE'
	option reality_short_id '0123456789abcdef'
	option utls_fingerprint 'chrome'

config node 'hy2_node'
	option type 'hysteria2'
	option server 'hy2.example.com'
	option server_port '443'
	list server_ports '12000:12010'
	option hop_interval '45s'
	option password 'fixture-hysteria2-password'
	option tls_server_name 'hy2.example.com'
	option obfs_type 'salamander'
	option obfs_password 'fixture-obfs-password'
	option up_mbps '10'
	option down_mbps '20'

config node 'trojan_node'
	option type 'trojan'
	option server 'trojan.example.com'
	option server_port '443'
	option password 'fixture-trojan-password'
	option tls_server_name 'trojan.example.com'

config outbound 'direct'
	option kind 'direct'
	option failure 'block'

config outbound 'block'
	option kind 'block'
	option failure 'block'

config outbound 'default_proxy'
	option kind 'single'
	option node 'reality_node'
	option failure 'block'

config outbound 'quic_proxy'
	option kind 'single'
	option node 'hy2_node'
	option failure 'block'

config outbound 'subscription_proxy'
	option kind 'single'
	option node 'trojan_node'
	option failure 'block'

config dns_server 'resolver_a'
	option protocol 'https'
	option server '1.1.1.1'
	option server_port '443'
	option path '/dns-query'
	option tls_server_name 'one.one.one.one'

config dns_server 'resolver_b'
	option protocol 'https'
	option server '8.8.8.8'
	option server_port '443'
	option path '/dns-query'
	option tls_server_name 'dns.google'

config dns_server 'resolver_c'
	option protocol 'https'
	option server '9.9.9.9'
	option server_port '443'
	option path '/dns-query'
	option tls_server_name 'dns.quad9.net'

config dns_profile 'direct_dns'
	option listen_port '6053'
	list server 'resolver_a'
	option response_mode 'fastest-ip'
	option speed_check_mode 'ping,tcp:443,tcp:80'
	option cache_size '32768'
	option cache_persist '1'
	option serve_expired '1'
	option rr_ttl_min '600'
	option failure 'block'

config dns_profile 'proxy_dns'
	option listen_port '6553'
	list server 'resolver_b'
	list server 'resolver_c'
	option response_mode 'fastest-response'
	option speed_check_mode 'none'
	option cache_size '32768'
	option cache_persist '1'
	option serve_expired '1'
	option rr_ttl_min '600'
	option failure 'block'

config rule 'resolver_a_direct'
	option name 'Resolver A direct'
	option enabled '1'
	list ip_match '1.1.1.1/32'
	list port '443'
	option dns_profile 'direct_dns'
	option outbound 'direct'

config rule 'resolver_b_proxy'
	option name 'Resolver B proxy'
	option enabled '1'
	list ip_match '8.8.8.8/32'
	list port '443'
	option dns_profile 'direct_dns'
	option outbound 'default_proxy'

config rule 'resolver_c_proxy'
	option name 'Resolver C proxy'
	option enabled '1'
	list ip_match '9.9.9.9/32'
	list port '443'
	option dns_profile 'direct_dns'
	option outbound 'subscription_proxy'

config rule 'client_direct'
	option name 'Example client direct'
	option enabled '1'
	list source_ip_cidr '192.0.2.10/32'
	list source_ip_cidr '2001:db8::10/128'
	option dns_profile 'direct_dns'
	option outbound 'direct'

config rule 'service_proxy'
	option name 'Example service proxy'
	option enabled '1'
	list domain_match 'domain:service.example'
	option dns_profile 'proxy_dns'
	option outbound 'quic_proxy'

config rule 'realtime_udp'
	option name 'Example realtime UDP'
	option enabled '1'
	list network 'udp'
	list port '12345'
	list port '23456'
	option dns_profile 'direct_dns'
	option outbound 'direct'

config rule 'disabled_example'
	option name 'Disabled example'
	option enabled '0'
	list domain_match 'domain:ads.example'
	option dns_profile 'missing_disabled_dns'
	option outbound 'missing_disabled_outbound'

config rule 'default'
	option name 'Default'
	option enabled '1'
	option default '1'
	option dns_profile 'proxy_dns'
	option outbound 'default_proxy'
