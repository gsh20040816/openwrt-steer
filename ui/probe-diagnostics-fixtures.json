{
  "schema_version": 1,
  "capability": {
    "overview": "Overview probes use the Saved URL and the device's current network environment, even while Steer is disabled. Success only proves that the configured URL was reachable at that time; it does not prove a particular outbound, DNS resolver, or absence of DNS leaks.",
    "temporary": "Node and Route probes validate an isolated temporary chain and do not prove which path the current Active rules selected."
  },
