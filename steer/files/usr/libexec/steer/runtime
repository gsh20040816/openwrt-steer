#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later

set -eu

RUN_ROOT=/var/run/steer
ACTIVE_PATH="$RUN_ROOT/active.path"
USE_ACTIVE="$RUN_ROOT/use-active"
NETWORK_ENABLED="$RUN_ROOT/network.enabled"
APPLY_STATE="$RUN_ROOT/apply.state"
APPLY_IN_PROGRESS="$RUN_ROOT/apply.in-progress"
BRIDGE_NF_STATE="$RUN_ROOT/bridge-nf.state"
BLOCKED_MARKER="$RUN_ROOT/blocked"
STATE_ROOT=/var/lib/steer
LKG_DIR=/etc/steer/last-known-good
LOCK_FILE=/var/lock/steer-apply.lock
SING_BOX_BIN=/usr/bin/sing-box
SMARTDNS_BIN=/usr/sbin/smartdns
HEALTH_ATTEMPTS=12

log() {
	logger -t steer -- "$*"
}

write_runtime_state() {
	local state="$1"
	local message="$2"
	local pending
	mkdir -p "$RUN_ROOT"
	pending="$APPLY_STATE.new.$$"
	printf 'state=%s\nmessage=%s\nupdated_at=%s\n' \
		"$state" "$message" "$(date +%s)" > "$pending"
	chmod 0600 "$pending"
	mv -f "$pending" "$APPLY_STATE"
}

# 写运行状态并同步 blocked 标记。blocked 标记用于阻止 start 的后续
# service_started 阶段重新加载失败的接管规则（开机事务总失败时）。
write_state() {
	local state="$1"
	local message="$2"
	write_runtime_state "$state" "$message"
	if [ "$state" = blocked ]; then
		touch "$BLOCKED_MARKER"
	else
		rm -f "$BLOCKED_MARKER"
	fi
}

die() {
	echo "steer: $*" >&2
	log "$*"
	if [ -f "$APPLY_IN_PROGRESS" ]; then
		write_runtime_state failed "$*"
		rm -f "$APPLY_IN_PROGRESS"
	fi
	exit 1
}

ensure_directories() {
	mkdir -p "$RUN_ROOT" "$STATE_ROOT/smartdns" /etc/steer /var/lock
	chmod 0700 "$RUN_ROOT" /etc/steer
}

active_directory() {
	[ -f "$ACTIVE_PATH" ] || return 1
	local path
	IFS= read -r path < "$ACTIVE_PATH"
	case "$path" in
		"$RUN_ROOT"/generation.*|"$LKG_DIR")
			[ -d "$path" ] || return 1
			printf '%s\n' "$path"
			;;
		*)
			return 1
			;;
	esac
}

activate_directory() {
	local path="$1"
	local pending="$ACTIVE_PATH.new.$$"
	case "$path" in
		"$RUN_ROOT"/generation.*|"$LKG_DIR") ;;
		*) die "拒绝激活不受 Steer 管理的目录：$path" ;;
	esac
	[ -d "$path" ] || die "待激活目录不存在：$path"
	printf '%s\n' "$path" > "$pending"
	mv -f "$pending" "$ACTIVE_PATH"
}

fail_conflict() {
	local message="$1"
	local steer_state
	steer_state="$(ubus call service list '{"name":"steer"}' 2>/dev/null || true)"
	if [ -f "$NETWORK_ENABLED" ] || echo "$steer_state" | grep -q '"running": true'; then
		if ! /etc/init.d/steer stop >/dev/null 2>&1; then
			die "$message；检测到 Steer 也在运行，但自动停止 Steer 失败，请立即手动停止"
		fi
		message="$message；为避免多个服务同时接管网络，Steer 已停止"
	fi
	die "$message"
}

check_conflicts() {
	local service state
	for service in passwall2 passwall openclash homeproxy momo smartdns; do
		[ -x "/etc/init.d/$service" ] || continue
		if "/etc/init.d/$service" enabled >/dev/null 2>&1; then
			if [ "$service" = smartdns ]; then
				fail_conflict '检测到系统 SmartDNS 已启用；Steer 使用自己的 SmartDNS 实例，请先在“系统 → 启动项”中停止并禁用系统 SmartDNS'
			fi
			fail_conflict "检测到已启用的透明代理服务 $service；请先明确停用它，Steer 不会自行修改其他服务"
		fi
		state="$(ubus call service list "{\"name\":\"$service\"}" 2>/dev/null || true)"
		case "$state" in
			*'"running": true'*)
				if [ "$service" = smartdns ]; then
					fail_conflict '检测到系统 SmartDNS 仍在运行；Steer 使用自己的 SmartDNS 实例，请先停止并禁用系统 SmartDNS'
				fi
				fail_conflict "检测到仍在运行的透明代理服务 $service；请先停止它"
				;;
		esac
	done

	# 即使服务已停止/禁用，passwall2 的 fw4 include 仍可能在 fw4 reload
	# 后重新安装整套 nftables 规则（含 -101 的 DNS 重定向）。只要残留表存在，
	# Steer 就拒绝接管，绝不与其共存。
	if nft list table inet passwall2 >/dev/null 2>&1; then
		fail_conflict '检测到 passwall2 残留 nftables 规则（inet passwall2 表仍存在）；请先清理：uci -q delete firewall.passwall2; uci commit firewall; fw4 reload，并确认 nft list tables 中不再有 inet passwall2'
	fi
	if nft list table inet passwall >/dev/null 2>&1; then
		fail_conflict '检测到 passwall 残留 nftables 规则（inet passwall 表仍存在）；请先清理后重试'
	fi
}

resolve_devices() {
	local output="$1"
	local raw="$output.raw"
	local zone zone_output device
	: > "$raw"

	for zone in $(uci -q get steer.main.managed_zone); do
		zone_output="$output.zone.$$"
		if ! fw4 -q zone "$zone" > "$zone_output"; then
			rm -f "$zone_output"
			die "受管 firewall zone 不存在：$zone"
		fi
		if [ ! -s "$zone_output" ]; then
			rm -f "$zone_output"
			die "受管 firewall zone 当前没有实际设备：$zone"
		fi
		while IFS= read -r device; do
			[ -n "$device" ] && printf '%s\n' "$device" >> "$raw"
		done < "$zone_output"
		rm -f "$zone_output"
	done

	sort -u "$raw" > "$output"
	rm -f "$raw"
	[ -s "$output" ] || die '没有解析到任何受管 ingress 设备'
}

render_candidate() {
	ensure_directories
	check_conflicts
	[ -x "$SING_BOX_BIN" ] || die "sing-box 不可执行：$SING_BOX_BIN"
	[ -x "$SMARTDNS_BIN" ] || die "SmartDNS 不可执行：$SMARTDNS_BIN"

	local candidate profile devices check_table
	candidate="$(mktemp -d "$RUN_ROOT/generation.XXXXXX")"
	chmod 0700 "$candidate"

	if [ "${STEER_GEODATA_STAGED:-0}" != 1 ] && ! /usr/libexec/steer/geodata ensure; then
		rm -rf "$candidate"
		die 'GeoSite/GeoIP 本地规则集准备失败'
	fi

	if ! steerctl validate > "$candidate/validation.json"; then
		rm -rf "$candidate"
		die 'UCI 意图模型校验失败'
	fi
	if ! steerctl compile-sing-box > "$candidate/sing-box.json"; then
		rm -rf "$candidate"
		die 'sing-box 配置编译失败'
	fi
	if ! "$SING_BOX_BIN" check -c "$candidate/sing-box.json"; then
		rm -rf "$candidate"
		die 'sing-box 原生配置检查失败'
	fi

	if ! steerctl list-smartdns > "$candidate/smartdns.instances"; then
		rm -rf "$candidate"
		die 'DNS Profile 清单编译失败'
	fi
	while IFS= read -r profile; do
		[ -n "$profile" ] || continue
		if ! steerctl compile-smartdns "$profile" > "$candidate/smartdns-$profile.conf"; then
			rm -rf "$candidate"
			die "DNS Profile 编译失败：$profile"
		fi
	done < "$candidate/smartdns.instances"

	devices="$candidate/managed.devices"
	resolve_devices "$devices"
	check_table="steer_check_$$"
	if ! steerctl compile-firewall --table "$check_table" $(cat "$devices") > "$candidate/firewall.check.nft"; then
		rm -rf "$candidate"
		die '透明代理规则编译失败'
	fi
	if ! nft -c -f "$candidate/firewall.check.nft"; then
		rm -rf "$candidate"
		die 'nftables 原生规则检查失败'
	fi
	if ! steerctl compile-firewall $(cat "$devices") > "$candidate/firewall.nft"; then
		rm -rf "$candidate"
		die '透明代理正式规则编译失败'
	fi
	steerctl runtime-settings > "$candidate/runtime.json"
	cp /etc/config/steer "$candidate/source-uci"
	rm -f "$candidate/firewall.check.nft"
	chmod 0600 "$candidate"/*
	printf '%s\n' "$candidate"
}

runtime_value() {
	local directory="$1"
	local field="$2"
	jsonfilter -q -i "$directory/runtime.json" -e "@['$field']"
}

route_stop() {
	local directory mark mask table priority
	directory="$(active_directory 2>/dev/null || true)"
	[ -n "$directory" ] || return 0
	mark="$(runtime_value "$directory" tproxy_mark)"
	mask="$(runtime_value "$directory" mark_mask)"
	table="$(runtime_value "$directory" route_table)"
	priority="$(runtime_value "$directory" rule_priority)"
	ip -4 rule del pref "$priority" fwmark "$mark/$mask" table "$table" >/dev/null 2>&1 || true
	ip -6 rule del pref "$priority" fwmark "$mark/$mask" table "$table" >/dev/null 2>&1 || true
	ip -4 route flush table "$table" >/dev/null 2>&1 || true
	ip -6 route flush table "$table" >/dev/null 2>&1 || true
}

route_start() {
	local directory mark mask table priority
	directory="$(active_directory)"
	mark="$(runtime_value "$directory" tproxy_mark)"
	mask="$(runtime_value "$directory" mark_mask)"
	table="$(runtime_value "$directory" route_table)"
	priority="$(runtime_value "$directory" rule_priority)"
	route_stop
	ip -4 route replace local default dev lo table "$table"
	ip -6 route replace local default dev lo table "$table"
	ip -4 rule add pref "$priority" fwmark "$mark/$mask" table "$table"
	ip -6 rule add pref "$priority" fwmark "$mark/$mask" table "$table"
}

firewall_load() {
	local directory
	directory="$(active_directory)"
	[ -s "$directory/firewall.nft" ] || die '当前运行代缺少 firewall.nft'
	nft delete table inet steer >/dev/null 2>&1 || true
	nft -f "$directory/firewall.nft"
}

bridge_nf_save() {
	mkdir -p "$RUN_ROOT"
	printf 'iptables=%s\nip6tables=%s\n' \
		"$(sysctl -n net.bridge.bridge-nf-call-iptables 2>/dev/null || echo 0)" \
		"$(sysctl -n net.bridge.bridge-nf-call-ip6tables 2>/dev/null || echo 0)" \
		> "$BRIDGE_NF_STATE"
}

# 桥接的转发流量只有在 bridge-nf-call-* 为 0 时才以 br-lan 名义进入
# prerouting（与 passwall2 的既有行为一致）；为 1 时走 br_netfilter 路径，
# Steer 的 iifname 规则无法匹配 LAN 转发流量。接管时必须设为 0 并在停止时恢复。
bridge_nf_disable() {
	bridge_nf_save
	sysctl -q -w net.bridge.bridge-nf-call-iptables=0 >/dev/null 2>&1 || true
	sysctl -q -w net.bridge.bridge-nf-call-ip6tables=0 >/dev/null 2>&1 || true
}

bridge_nf_restore() {
	[ -f "$BRIDGE_NF_STATE" ] || return 0
	local ipt ip6
	ipt="$(sed -n 's/^iptables=//p' "$BRIDGE_NF_STATE")"
	ip6="$(sed -n 's/^ip6tables=//p' "$BRIDGE_NF_STATE")"
	[ -n "$ipt" ] && sysctl -q -w net.bridge.bridge-nf-call-iptables="$ipt" >/dev/null 2>&1 || true
	[ -n "$ip6" ] && sysctl -q -w net.bridge.bridge-nf-call-ip6tables="$ip6" >/dev/null 2>&1 || true
	rm -f "$BRIDGE_NF_STATE"
}

network_start() {
	bridge_nf_disable
	route_start
	if ! firewall_load; then
		route_stop
		bridge_nf_restore
		die '透明代理规则加载失败'
	fi
	touch "$NETWORK_ENABLED"
}

network_stop() {
	rm -f "$NETWORK_ENABLED"
	nft delete table inet steer >/dev/null 2>&1 || true
	route_stop
	bridge_nf_restore
}

instance_running() {
	local state_file="$1"
	local instance="$2"
	[ "$(jsonfilter -q -i "$state_file" -e "@['steer']['instances']['$instance']['running']")" = 'true' ]
}

probe_log() {
	log "健康检查：$*"
}

# 用 dig 向 127.0.0.1:$port 查询 $domain 的 A 记录，要求返回真实 IPv4 答案。
# 直接命中 Steer 的 sing-box DNS（1053），覆盖 DNS Profile 与上游链路。
dns_probe() {
	local port="$1"
	local domain="$2"
	local answer
	command -v dig >/dev/null 2>&1 || { probe_log "缺少 dig（bind-dig），无法执行 DNS 探测"; return 1; }
	answer="$(dig @127.0.0.1 -p "$port" +time=2 +tries=1 -t A "$domain" +short 2>/dev/null |
		grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1)"
	[ -n "$answer" ]
}

# 用 curl 发起真实 HTTP(S) 请求，验证 Steer 透明接管的数据面：
# 先经 $3 指定的本机 DNS 端口拿到未被污染的 IP，再以 --resolve 走 Steer 的 TPROXY 出口链路。
# 参数：$1 = URL，$2 = 期望的 HTTP 状态码，$3 = 本机 DNS 监听端口（来自运行代 runtime.json）。
http_probe() {
	local url="$1"
	local expect="$2"
	local dns_port="$3"
	local host port ip code
	command -v curl >/dev/null 2>&1 || { probe_log "缺少 curl，无法执行 HTTP 探测"; return 1; }
	host="${url#*://}"
	host="${host%%/*}"
	case "$host" in
		*:*) port="${host##*:}"; host="${host%%:*}" ;;
		*) case "$url" in https://*) port=443 ;; *) port=80 ;; esac ;;
	esac
	ip="$(dig @127.0.0.1 -p "$dns_port" +time=2 +tries=1 -t A "$host" +short 2>/dev/null |
		grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1)"
	[ -n "$ip" ] || return 1
	code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 --noproxy '*' \
		--resolve "$host:$port:$ip" "$url" 2>/dev/null)"
	[ "$code" = "$expect" ]
}

health_check() {
	local directory state_file attempt profile healthy dns_port
	directory="$(active_directory)"
	dns_port="$(runtime_value "$directory" dns_port)"
	[ -n "$dns_port" ] || { probe_log "运行代缺少 dns_port，无法执行 DNS 探测"; return 1; }
	state_file="$RUN_ROOT/service-state.json"
	attempt=0
	while [ "$attempt" -lt "$HEALTH_ATTEMPTS" ]; do
		attempt=$((attempt + 1))
		sleep 1
		check_conflicts
		ubus call service list '{"name":"steer"}' > "$state_file" 2>/dev/null || true
		healthy=1
		instance_running "$state_file" core || healthy=0
		while IFS= read -r profile; do
			[ -n "$profile" ] || continue
			instance_running "$state_file" "dns_$profile" || healthy=0
		done < "$directory/smartdns.instances"
		nft list table inet steer >/dev/null 2>&1 || healthy=0
		if [ "$healthy" = 1 ]; then
			if dns_probe "$dns_port" www.baidu.com &&
			   dns_probe "$dns_port" www.google.com &&
			   dns_probe "$dns_port" github.com &&
			   http_probe 'http://www.baidu.com/' 200 "$dns_port" &&
			   http_probe 'https://www.google.com/generate_204' 204 "$dns_port" &&
			   http_probe 'https://github.com/' 200 "$dns_port"; then
				rm -f "$state_file"
				return 0
			fi
			probe_log "进程与规则就绪，但 baidu/google/github 端到端探测未通过（第 $attempt/$HEALTH_ATTEMPTS 次），继续等待"
		fi
	done
	rm -f "$state_file"
	return 1
}

commit_lkg() {
	local source="$1"
	local pending=/etc/steer/last-known-good.new
	local previous=/etc/steer/last-known-good.old
	rm -rf "$pending" "$previous"
	mkdir -p "$pending"
	cp -a "$source"/. "$pending"/
	chmod 0700 "$pending"
	[ ! -d "$LKG_DIR" ] || mv "$LKG_DIR" "$previous"
	mv "$pending" "$LKG_DIR"
	rm -rf "$previous"
}

# 服务启动之后与 Apply 相同的收尾事务：端到端健康检查 -> 提交
# last-known-good -> 写运行状态；失败时回退上一运行代或 LKG。
# 模式:
#   apply - 用户/面板触发的 apply（回退后仍以失败退出，供 RPC 感知）
#   boot  - 开机事务（回退到 LKG 后视为成功；全部失败写出 blocked 并停止接管）
post_start_verify() {
	local candidate="$1"
	local mode="${2:-apply}"
	local previous="${3:-}"
	local rollback_target

	if health_check; then
		if ! /etc/init.d/steer enable >/dev/null 2>&1 ||
		   ! /etc/init.d/steer-geodata enable >/dev/null 2>&1; then
			/etc/init.d/steer stop >/dev/null 2>&1 || true
			log '开机启动项启用失败，已停止服务'
			write_state failed 'Steer 已启动，但开机启动项启用失败；为避免状态不一致，已停止服务'
			return 1
		fi
		if ! commit_lkg "$candidate"; then
			/etc/init.d/steer stop >/dev/null 2>&1 || true
			log '恢复点写入失败，已停止服务'
			write_state failed 'Steer 已启动，但恢复点写入失败；为避免无法回滚，已停止服务'
			return 1
		fi
		if [ "$mode" = boot ]; then
			write_state active '（开机事务）Steer 已启动并通过健康检查'
			log "开机事务已应用并记录 last-known-good：$candidate"
		else
			write_state active 'Steer 已启动并通过健康检查'
			log "已应用并记录 last-known-good：$candidate"
		fi
		echo 'Steer 配置已应用。'
		return 0
	fi

	log '新配置启动后健康检查失败，开始恢复上一运行代'
	/etc/init.d/steer stop >/dev/null 2>&1 || true
	rollback_target="$previous"
	if [ -z "$rollback_target" ] || [ ! -d "$rollback_target" ]; then
		rollback_target="$LKG_DIR"
	fi
	if [ -d "$rollback_target" ]; then
		check_conflicts
		activate_directory "$rollback_target"
		touch "$USE_ACTIVE"
		if /etc/init.d/steer start >/dev/null 2>&1; then
			if health_check; then
				if [ "$mode" = boot ]; then
					write_state active '（开机事务）新配置未通过健康检查，已回退到 last-known-good 运行'
					log "开机事务已回退到 last-known-good：$rollback_target"
					echo 'Steer 开机事务：新配置未通过健康检查，已回退到 last-known-good 运行。'
				else
					log "已恢复运行代：$rollback_target"
					write_state failed '新配置未能稳定运行，已恢复上一运行代'
					echo 'steer: 新配置未能稳定运行，已恢复上一运行代' >&2
				fi
				return 1
			fi
			log "回退目标 $rollback_target 已启动，但健康检查未通过，继续下一步处理"
		fi
	fi
	/etc/init.d/steer stop >/dev/null 2>&1 || true
	if [ "$mode" = boot ]; then
		write_state blocked '（开机事务）候选配置与 last-known-good 均未通过健康检查；已停止接管，网络恢复为直连以便修复'
		echo 'steer: （开机事务）候选配置与 last-known-good 均未通过健康检查；已停止接管' >&2
	else
		write_state failed '新配置未能稳定运行，而且没有可用的健康运行代可恢复'
		echo 'steer: 新配置未能稳定运行，而且没有可用的健康运行代可恢复' >&2
	fi
	return 1
}

apply_configuration() {
	ensure_directories
	exec 9>"$LOCK_FILE"
	flock -x 9
	touch "$APPLY_IN_PROGRESS"

	if [ "$(uci -q get steer.main.enabled || true)" != 1 ]; then
		write_runtime_state stopping '正在停止 Steer 并撤销网络接管'
		if ! /etc/init.d/steer stop >/dev/null 2>&1; then
			die 'Steer 服务停止失败'
		fi
		if ! /etc/init.d/steer disable >/dev/null 2>&1 ||
		   ! /etc/init.d/steer-geodata disable >/dev/null 2>&1; then
			die 'Steer 开机启动项禁用失败'
		fi
		rm -f "$APPLY_IN_PROGRESS" "$BLOCKED_MARKER"
		write_runtime_state disabled 'Steer 已停用，网络接管已撤销'
		echo 'Steer 已停用。'
		return 0
	fi

	local candidate previous rc
	write_runtime_state applying '正在检查配置、服务冲突和 GeoSite/GeoIP 数据'
	candidate="$(render_candidate)"
	previous="$(active_directory 2>/dev/null || true)"
	write_runtime_state applying '正在执行切换前最终冲突检查'
	check_conflicts
	activate_directory "$candidate"
	touch "$USE_ACTIVE"
	write_runtime_state applying '正在启动 sing-box、DNS Profile 和透明代理规则'
	if ubus call service list '{"name":"steer"}' 2>/dev/null | grep -q '"steer"'; then
		if ! /etc/init.d/steer restart; then
			die 'Steer 服务重启失败'
		fi
	else
		if ! /etc/init.d/steer start; then
			die 'Steer 服务启动失败'
		fi
	fi

	write_runtime_state applying '正在验证核心、DNS Profile、透明代理与端到端连通性'
	post_start_verify "$candidate" apply "$previous"
	rc=$?
	rm -f "$APPLY_IN_PROGRESS"
	return "$rc"
}

command="${1:-}"
case "$command" in
	stage)
		render_candidate
		;;
	activate)
		[ -n "${2:-}" ] || die 'activate 缺少目录参数'
		activate_directory "$2"
		;;
	active-directory)
		active_directory
		;;
	network-start)
		network_start
		;;
	network-stop)
		network_stop
		;;
	firewall-reload)
		[ -f "$NETWORK_ENABLED" ] && firewall_load
		;;
	health-check)
		health_check
		;;
	post-start-verify)
		[ -n "${2:-}" ] || die 'post-start-verify 缺少候选目录参数'
		post_start_verify "$2" "${3:-apply}" "${4:-}"
		;;
	state)
		[ -n "${2:-}" ] || die 'state 缺少状态参数'
		write_state "$2" "${3:-}"
		;;
	apply)
		apply_configuration
		;;
	*)
		die '用法：runtime stage|activate <dir>|active-directory|network-start|network-stop|firewall-reload|health-check|post-start-verify <candidate> [boot|apply] [previous]|state <state> <message>|apply'
		;;
esac
