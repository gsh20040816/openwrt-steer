#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later

set -eu
umask 077

STATE_ROOT=/var/lib/steer/geodata
SEED_ROOT=/usr/share/steer/geodata-seed
CURRENT="$STATE_ROOT/current"
LOCK_FILE=/var/lock/steer-geodata.lock
GEOVIEW=/usr/bin/geoview
SING_BOX=/usr/bin/sing-box

log() {
	logger -t steer-geodata -- "$*"
}

die() {
	local message="$*"
	echo "steer-geodata: $message" >&2
	log "$message"
	exit 1
}

prepare() {
	mkdir -p "$STATE_ROOT" /var/lock
}

rules_file() {
	local kind="$1"
	local output="$2"
	steerctl list-geo-rules "$kind" > "$output"
}

compile_rules() {
	local kind="$1"
	local source="$2"
	local list="$3"
	local output="$4"
	local id listed_kind category source_json tab
	tab="$(printf '\t')"
	mkdir -p "$output"
	while IFS="$tab" read -r id listed_kind category; do
		[ -n "$id" ] || continue
		[ "$listed_kind" = "$kind" ] || die "规则集类型不一致：$id"
		source_json="$output/$id.json"
		if ! "$GEOVIEW" -action convert -input "$source" -type "$kind" \
			-list "$category" -format json -strict -output "$source_json"; then
			return 1
		fi
		if ! "$SING_BOX" rule-set compile --output "$output/$id.srs" "$source_json"; then
			return 1
		fi
		rm -f "$source_json"
	done < "$list"
}

activate_generation() {
	local generation="$1"
	local pending="$STATE_ROOT/current.new.$$"
	ln -s "$generation" "$pending"
	mv -fT "$pending" "$CURRENT"
}

package_release() {
	[ -s "$SEED_ROOT/release" ] || die 'steer-geodata 包缺少 release 元数据'
	cat "$SEED_ROOT/release"
}

generation_ready() {
	local current="$1"
	local required="$2"
	local release="$3"
	local id kind category tab
	[ -f "$current/rules.tsv" ] || return 1
	[ -f "$current/package.release" ] || return 1
	cmp -s "$required" "$current/rules.tsv" || return 1
	[ "$(cat "$current/package.release")" = "$release" ] || return 1
	tab="$(printf '\t')"
	while IFS="$tab" read -r id kind category; do
		[ -n "$id" ] || continue
		[ -s "$current/rules/$id.srs" ] || return 1
	done < "$required"
}

ensure_active() {
	local workspace required geosite_rules geoip_rules current generation release
	workspace="$(mktemp -d /tmp/steer-geodata-ensure.XXXXXX)"
	required="$workspace/rules.tsv"
	geosite_rules="$workspace/geosite.tsv"
	geoip_rules="$workspace/geoip.tsv"
	steerctl list-geo-rules > "$required"
	rules_file geosite "$geosite_rules"
	rules_file geoip "$geoip_rules"
	release="$(package_release)"
	current=''
	if [ -L "$CURRENT" ]; then
		current="$(readlink -f "$CURRENT" 2>/dev/null || true)"
		[ -d "$current" ] || current=''
	fi

	if [ -n "$current" ] && generation_ready "$current" "$required" "$release"; then
		rm -rf "$workspace"
		return 0
	fi
	if [ ! -s "$required" ]; then
		rm -rf "$workspace"
		return 0
	fi

	[ -s "$SEED_ROOT/geosite.dat" ] || die 'steer-geodata 包缺少 GeoSite 数据'
	[ -s "$SEED_ROOT/geoip.dat" ] || die 'steer-geodata 包缺少 GeoIP 数据'
	[ -x "$GEOVIEW" ] || die "geoview 不可执行：$GEOVIEW"
	[ -x "$SING_BOX" ] || die "sing-box 不可执行：$SING_BOX"

	generation="$(mktemp -d "$STATE_ROOT/generation.XXXXXX")"
	cp "$SEED_ROOT/geosite.dat" "$generation/geosite.dat"
	cp "$SEED_ROOT/geoip.dat" "$generation/geoip.dat"
	cp "$required" "$generation/rules.tsv"
	printf '%s\n' "$release" > "$generation/package.release"
	if ! compile_rules geosite "$generation/geosite.dat" "$geosite_rules" "$generation/rules"; then
		rm -rf "$generation" "$workspace"
		die 'GeoSite 分类缺失或转换失败；已保留当前运行代'
	fi
	if ! compile_rules geoip "$generation/geoip.dat" "$geoip_rules" "$generation/rules"; then
		rm -rf "$generation" "$workspace"
		die 'GeoIP 分类缺失或转换失败；已保留当前运行代'
	fi
	activate_generation "$generation"
	rm -rf "$workspace"
	log "已从 steer-geodata 包准备本地规则集：$release"
}

catalog() {
	local kind="$1"
	case "$kind" in
		geosite|geoip) ;;
		*) die '分类目录类型只能是 geosite 或 geoip' ;;
	esac
	[ -s "$SEED_ROOT/$kind.dat" ] || die "steer-geodata 包缺少 $kind 数据文件"
	[ -x "$GEOVIEW" ] || die "geoview 不可执行：$GEOVIEW"
	"$GEOVIEW" -action extract -input "$SEED_ROOT/$kind.dat" -type "$kind"
}

case "${1:-}" in
	ensure)
		prepare
		exec 9>"$LOCK_FILE"
		flock -x 9
		ensure_active
		;;
	catalog) catalog "${2:-}" ;;
	*) die '用法：geodata ensure|catalog <geosite|geoip>' ;;
esac
