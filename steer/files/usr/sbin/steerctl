 */

'use strict';

import { load_uci_model, validate_model, compile_model, collect_geo_rule_sets } from '/usr/share/steer/model.uc';
import { compile_firewall } from '/usr/share/steer/firewall.uc';

function usage() {
	warn('Usage: steerctl validate|compile|compile-sing-box|compile-smartdns <profile-id>|list-smartdns|list-geo-rules [geosite|geoip]|compile-firewall [--table <name>] <device>...|apply\n');
	exit(2);
}

const command = ARGV[0];
if (command == null)
	usage();

if (command == 'apply') {
	const status = system([ '/usr/libexec/steer/runtime', 'apply' ]);
	exit(status);
}

const model = load_uci_model('steer');

if (command == 'validate') {
	const result = validate_model(model);
	print(sprintf('%.J\n', result));
	exit(result.ok ? 0 : 1);
}

if (command == 'compile') {
	const result = compile_model(model);
	if (!result.ok) {
		print(sprintf('%.J\n', result));
		exit(1);
	}

	print(sprintf('%.J\n', result));
	exit(0);
}

if (command == 'compile-sing-box') {
	const result = compile_model(model);
	if (!result.ok) {
		print(sprintf('%.J\n', result));
		exit(1);
	}

	print(sprintf('%.J\n', result.sing_box));
	exit(0);
}

if (command == 'compile-smartdns') {
	const profile_id = ARGV[1];
	if (profile_id == null)
		usage();

	const result = compile_model(model);
	if (!result.ok) {
		print(sprintf('%.J\n', result));
		exit(1);
	}

	for (let instance in result.smartdns_instances) {
		if (instance.id == profile_id) {
			print(instance.config);
			exit(0);
		}
	}

	warn(`DNS Profile 不存在或未启用：${profile_id}\n`);
	exit(1);
}

if (command == 'list-smartdns') {
	const result = compile_model(model);
	if (!result.ok) {
		print(sprintf('%.J\n', result));
		exit(1);
	}

	for (let instance in result.smartdns_instances)
		print(`${instance.id}\n`);
	exit(0);
}

if (command == 'list-geo-rules') {
	const result = validate_model(model);
	if (!result.ok) {
		print(sprintf('%.J\n', result));
		exit(1);
	}

	const requested_kind = ARGV[1];
	if (requested_kind != null && !(requested_kind in [ 'geosite', 'geoip' ]))
		usage();

	for (let rule_set in collect_geo_rule_sets(model, requested_kind))
		print(`${rule_set.id}\t${rule_set.kind}\t${rule_set.category}\n`);
	exit(0);
}

if (command == 'runtime-settings') {
	const validation = validate_model(model);
	if (!validation.ok) {
		print(sprintf('%.J\n', validation));
		exit(1);
	}

	print(sprintf('%.J\n', {
		tproxy_mark: model.main.tproxy_mark,
		mark_mask: model.main.mark_mask,
		route_table: model.main.route_table,
		rule_priority: model.main.rule_priority
	}));
	exit(0);
}

if (command == 'compile-firewall') {
	const validation = validate_model(model);
	if (!validation.ok) {
		print(sprintf('%.J\n', validation));
		exit(1);
	}

	let table_name = 'steer';
	let offset = 1;
	if (ARGV[1] == '--table') {
		if (ARGV[2] == null)
			usage();
		table_name = ARGV[2];
		offset = 3;
	}

	const result = compile_firewall(model.main, slice(ARGV, offset), table_name);
	if (!result.ok) {
		warn(`${result.code}: ${result.message}\n`);
		exit(1);
	}

	print(result.config);
	exit(0);
}

usage();
