msgid "Use a loopback address unless LAN clients must connect directly. Non-loopback listeners require authentication."
msgstr "除非 LAN 客户端必须直接连接，否则请使用环回地址。非环回监听地址必须启用身份验证。"

msgid "Use stable DHCP leases or stable IPv6 addresses when a rule belongs to one device."
msgstr "当规则属于某一台设备时，请使用固定 DHCP 租约或稳定的 IPv6 地址。"

msgid "Username"
msgstr "用户名"

msgid "Username and password must either both be set or both be empty."
msgstr "用户名和密码必须同时设置或同时留空。"

msgid "Warning"
msgstr "警告"

msgid "Checking conflicts, generating configuration and verifying services."
msgstr "正在检查服务冲突、生成配置并验证服务状态。"

msgid "Configuration switch"
msgstr "配置开关"

msgid "Do not start another transparent proxy or the system SmartDNS while this check is running."
msgstr "检查期间请勿启动其他透明代理或系统 SmartDNS。"

msgid "Saving and applying this switch also synchronizes Steer startup at boot. Stop and disable other transparent proxies and the system SmartDNS before enabling it."
msgstr "保存并应用此开关时会同步 Steer 的开机启动状态。启用前请先停止并禁用其他透明代理和系统 SmartDNS。"

msgid "Starting Steer"
msgstr "正在启动 Steer"

msgid "Steer is blocked by conflicting services"
msgstr "Steer 被冲突服务阻止"

