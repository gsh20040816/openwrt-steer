msgstr "Steer 正在停止"

msgid "Steer is still running while disabled"
msgstr "Steer 在配置已停用时仍在运行"

msgid "Steer will not stop or disable another service automatically."
msgstr "Steer 不会自动停止或禁用其他服务。"

msgid "Stop and disable conflicting services before starting Steer"
msgstr "启动 Steer 前请先停止并禁用以下冲突服务"

msgid "The apply request failed before Steer returned a diagnostic message."
msgstr "Steer 返回诊断信息前，应用请求已经失败。"

msgid "The last apply failed"
msgstr "上次应用失败"

msgid "currently running"
msgstr "正在运行"

msgid "enabled at boot"
msgstr "已设为开机启动"

msgid "When enabled, the router’s own public TCP/UDP traffic and traditional DNS use the same ordered rules as managed clients."
msgstr "启用后，路由器自身的公网 TCP/UDP 流量和传统 DNS 将与受管理客户端使用相同的有序规则。"

msgid "uTLS fingerprint"
msgstr "uTLS 指纹"

msgid "Add to pending changes"
msgstr "添加到待提交变更"

msgid "An IPv6 server address must be enclosed in brackets."
msgstr "IPv6 服务器地址必须放在方括号中。"

