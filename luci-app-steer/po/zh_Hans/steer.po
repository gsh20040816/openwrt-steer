msgstr "已禁用"

msgid "Ignored compatibility-only parameter: %s"
msgstr "已忽略仅用于兼容的参数：%s"

msgid "Import node"
msgstr "导入节点"

msgid "Import proxy node"
msgstr "导入代理节点"

msgid "Import share URL"
msgstr "导入分享 URL"

msgid "Node import failed"
msgstr "节点导入失败"

msgid "Parse and review"
msgstr "解析并审查"

msgid "Parse one VLESS, Hysteria2 or Trojan share URL in this browser. The URL is never sent to a Steer RPC or written to logs."
msgstr "在本浏览器中解析一个 VLESS、Hysteria2 或 Trojan 分享 URL。该 URL 不会发送给 Steer RPC，也不会写入日志。"

msgid "Paste exactly one share URL. Credentials are hidden from the preview and are stored only after you confirm."
msgstr "请粘贴一个分享 URL。预览会隐藏凭据，只有确认后才会保存。"

msgid "Paste one share URL."
msgstr "请粘贴一个分享 URL。"

msgid "Present; hidden from preview"
msgstr "已提供；预览中隐藏"

msgid "REALITY parameters"
msgstr "REALITY 参数"

msgid "Review imported node"
msgstr "审查导入节点"

msgid "Review parser warnings"
msgstr "检查解析警告"

msgid "Steer cannot preserve this UDP packet encoding."
msgstr "Steer 无法保留该 UDP 数据包编码。"

msgid "Steer cannot preserve this VLESS encryption mode."
msgstr "Steer 无法保留该 VLESS 加密模式。"

msgid "Steer cannot preserve this VLESS flow."
msgstr "Steer 无法保留该 VLESS flow。"

msgid "Steer cannot preserve this security mode."
msgstr "Steer 无法保留该安全模式。"

msgid "Steer cannot preserve this transport header."
msgstr "Steer 无法保留该传输头部。"

msgid "Steer cannot preserve this transport type."
msgstr "Steer 无法保留该传输类型。"

msgid "Steer currently supports only Hysteria2 Salamander obfuscation."
msgstr "Steer 当前仅支持 Hysteria2 Salamander 混淆。"

msgid "The share URL contains a parameter that Steer cannot preserve."
msgstr "分享 URL 包含 Steer 无法保留的参数。"

msgid "The share URL contains an invalid boolean parameter."
msgstr "分享 URL 包含无效的布尔参数。"

msgid "The share URL contains an invalid port or port range."
msgstr "分享 URL 包含无效的端口或端口范围。"

msgid "The share URL contains an invalid positive integer."
msgstr "分享 URL 包含无效的正整数。"

msgid "The share URL contains an invalid server address."
msgstr "分享 URL 包含无效的服务器地址。"

msgid "The share URL contains an invalid server and port."
msgstr "分享 URL 包含无效的服务器和端口。"

msgid "The share URL contains conflicting parameter aliases."
msgstr "分享 URL 包含互相冲突的参数别名。"

msgid "The share URL contains invalid percent encoding."
msgstr "分享 URL 包含无效的百分号编码。"

msgid "The share URL could not be parsed."
msgstr "无法解析该分享 URL。"

msgid "The share URL does not contain credentials."
msgstr "分享 URL 中没有凭据。"

msgid "The share URL is malformed."
msgstr "分享 URL 格式错误。"

msgid "The share URL is missing a required parameter."
msgstr "分享 URL 缺少必需参数。"

msgid "The VLESS credential is not a UUID."
msgstr "VLESS 凭据不是有效的 UUID。"

msgid "This parameter requires Hysteria2 obfuscation."
msgstr "该参数要求启用 Hysteria2 混淆。"

msgid "This parameter requires REALITY security."
msgstr "该参数要求使用 REALITY 安全层。"

msgid "This parameter requires TLS or REALITY security."
msgstr "该参数要求使用 TLS 或 REALITY 安全层。"

msgid "This share URL protocol is not supported."
msgstr "不支持该分享 URL 协议。"

msgid "This share URL uses an unsupported path."
msgstr "该分享 URL 使用了不支持的路径。"

msgid "Unsupported transport or security fields stop the import instead of being silently discarded."
msgstr "遇到不支持的传输或安全字段时会停止导入，不会静默丢弃。"

msgid "%s is not a valid %s name in the current Geo data."
msgstr "%s 不是当前 Geo 数据中的合法 %s 名称。"

msgid "Remote data did not change local policy. Review the affected rules below."
msgstr "远程数据没有改变本地策略。请检查下方受影响的规则。"

msgid "The valid-name catalog is unavailable: %s"
msgstr "合法名称目录不可用：%s"

msgid "Unknown error"
msgstr "未知错误"

msgid "%d destination IP expressions"
msgstr "%d 个目的 IP 表达式"

msgid "%d matches."
msgstr "%d 个候选。"

msgid "%d matches; showing the first %d."
msgstr "共 %d 个候选，显示前 %d 个。"

msgid "%d valid %s names are available for dynamic completion."
msgstr "当前有 %d 个合法 %s 名称可用于动态补全。"

msgid "Destination IP match"
msgstr "目的 IP 匹配"

msgid "Domain match"
msgstr "域名匹配"

msgid "One IP, CIDR or geoip: expression per line. Lines are OR. This field affects traffic routing but not DNS selection."
msgstr "每行填写一个 IP、CIDR 或 geoip: 表达式，行与行之间为或关系。该字段只参与流量路由，不参与 DNS 选择。"

msgid "One expression per line. Plain text is a keyword; full:, domain:, regexp: and geosite: select exact, suffix, regular-expression and GeoSite matching. Lines are OR."
msgstr "每行填写一个表达式。纯文本表示关键词；full:、domain:、regexp: 和 geosite: 分别表示精确域名、域名后缀、正则表达式和 GeoSite 匹配。行与行之间为或关系。"

msgid "Rules run from top to bottom. Entries inside one field are OR; all non-empty fields are AND. DNS evaluates only domain, inbound and client conditions."
msgstr "规则从上到下执行。同一字段内的条目为或关系，所有非空字段之间为与关系。DNS 只判断域名、入站和客户端条件。"

msgid "Matches LAN clients before IP routing, so the same rule covers IPv4, IPv6, SLAAC and temporary addresses. It cannot be combined with a local proxy inbound."
msgstr "在 IP 路由前匹配局域网客户端，因此同一条规则同时覆盖 IPv4、IPv6、SLAAC 和临时地址。不能与本地代理入站同时使用。"
