#!/usr/bin/ucode
/* SPDX-License-Identifier: GPL-3.0-or-later */

'use strict';

import { mkdtemp, open, popen, rmdir, unlink } from 'fs';

function shellquote(value) {
	if (value == null)
		value = '';

	return "'" + replace(value, "'", "'\\''") + "'";
}

function command_json(command) {
	const process = popen(command);
	if (!process)
		return { ok: false, error: '无法启动 Steer 控制程序' };
	const output = process.read('all') || '';
	const status = process.close();
	let result;
	try {
		result = json(output);
	}
	catch (error) {
		return { ok: false, status, error: trim(output) || `${error}` };
	}
	if (status !== 0 && result.error == null)
		result.error = `Steer 控制程序退出状态：${status}`;
	return result;
}

function command_json_input(arguments, input) {
	const directory = mkdtemp('/tmp/steer-import-XXXXXX');
	if (!directory)
		return { ok: false, error: '无法创建私有导入目录' };
	const output = directory + '/result.json';
	const process = popen([ '/usr/sbin/steer', ...arguments, '--output', output ], 'w');
	if (!process) {
		rmdir(directory);
		return { ok: false, error: '无法启动 Steer 节点解析器' };
	}
	process.write(input || '');
	const status = process.close();
	const file = open(output, 'r');
	const content = file ? (file.read('all') || '') : '';
	if (file)
		file.close();
	unlink(output);
	rmdir(directory);
	if (status != 0)
		return { ok: false, status, error: '节点分享链接解析失败' };
	try {
		return json(content);
	}
	catch (error) {
		return { ok: false, status, error: trim(content) || `${error}` };
	}
}

const methods = {
	status: {
		call: function() {
			return command_json('/usr/sbin/steer status');
		}
	},
	validate: {
		call: function() {
			return command_json('/usr/sbin/steer validate');
		}
	},
	intent: {
		call: function() {
			return command_json('/usr/sbin/steer _export-intent');
		}
	},
	runtime: {
		call: function() {
			return command_json('/usr/sbin/steer _runtime');
		}
	},
	logs: {
		call: function() {
			const process = popen([ '/sbin/logread', '-e', 'steer' ], 'r');
			if (!process)
				return { ok: false, error: '无法读取系统日志' };
			const output = process.read('all') || '';
			const status = process.close();
			return { ok: status == 0, output, error: status == 0 ? null : 'logread 执行失败' };
		}
	},
	geodata_catalog: {
		call: function() {
			const geosite = command_json('/usr/sbin/steer geo-catalog --kind geosite');
			const geoip = command_json('/usr/sbin/steer geo-catalog --kind geoip');
			return {
				geosite: geosite.names ? { ok: true, names: geosite.names } : { ok: false, names: [], error: geosite.error },
				geoip: geoip.names ? { ok: true, names: geoip.names } : { ok: false, names: [], error: geoip.error }
			};
		}
	},
	subscriptions: {
		call: function() {
			return command_json('/usr/sbin/steer subscription status');
		}
	},
	subscription_update: {
		args: { id: '' },
		call: function(request) {
			const id = request?.args?.id;
			if (!id)
				return { ok: false, error: '缺少订阅 ID' };
			return command_json('/usr/sbin/steer subscription update --id ' + shellquote(id));
		}
	},
	subscription_clean: {
		args: { id: '', node: '' },
		call: function(request) {
			const id = request?.args?.id;
			const node = request?.args?.node;
			if (!id || !node)
				return { ok: false, error: '缺少订阅 ID 或节点 ID' };
			return command_json('/usr/sbin/steer subscription clean --id ' + shellquote(id) + ' --node ' + shellquote(node));
		}
	},
	node_speedtest: {
		args: { node: '', download: false },
		call: function(request) {
			const node = request?.args?.node;
			if (!node)
				return { ok: false, error: '缺少节点 ID' };
			let command = '/usr/sbin/steer probe --kind speedtest --node ' + shellquote(node);
			if (request.args.download)
				command += ' --download';
			return command_json(command);
		}
	},
	route_speedtest: {
		args: { route: '', download: false },
		call: function(request) {
			const route = request?.args?.route;
			if (!route)
				return { ok: false, error: '缺少路由 ID' };
			let command = '/usr/sbin/steer probe --kind speedtest --route ' + shellquote(route);
			if (request.args.download)
				command += ' --download';
			return command_json(command);
		}
	},
	overview_probe: {
		args: { kind: '' },
		call: function(request) {
			const kind = request?.args?.kind;
			if (kind != 'direct' && kind != 'proxy' && kind != 'speedtest')
				return { ok: false, error: '测试类型必须是 direct、proxy 或 speedtest' };
			return command_json('/usr/sbin/steer probe --kind ' + kind);
		}
	},
	node_import: {
		args: { document: '' },
		call: function(request) {
			const document = request?.args?.document;
			if (!document)
				return { ok: false, error: '缺少节点分享链接' };
			return command_json_input([ '_parse-nodes' ], document);
		}
	}
};

return { 'luci.steer': methods };
