#!/usr/bin/ucode
/* SPDX-License-Identifier: GPL-3.0-or-later */

'use strict';

import { access, popen } from 'fs';

function command_json(command) {
	const process = popen(command);
	if (!process)
		return { ok: false, error: '无法启动 Steer 控制程序' };
	const output = process.read('all') || '';
	const status = process.close();
	let result;
	try {
		result = json(output);
	}
	catch (error) {
		return { ok: false, status, error: trim(output) || `${error}` };
	}
	if (status !== 0 && result.error == null)
		result.error = `Steer 控制程序退出状态：${status}`;
	return result;
}

const methods = {
	status: {
		call: function() {
			return command_json('/usr/sbin/steer status');
		}
	},
	validate: {
		call: function() {
			return command_json('/usr/sbin/steer validate');
		}
	},
	plan: {
		call: function() {
			const current = '/run/steer/current/plan.json';
			return command_json(access(current) ?
				`/usr/sbin/steer plan --current-plan ${current}` :
				'/usr/sbin/steer plan');
		}
	},
	rollback: {
		call: function() {
			return command_json('/usr/sbin/steer rollback');
		}
	},
	geodata_catalog: {
		call: function() {
			const geosite = command_json('/usr/sbin/steer geo-catalog --kind geosite');
			const geoip = command_json('/usr/sbin/steer geo-catalog --kind geoip');
			return {
				geosite: geosite.names ? { ok: true, names: geosite.names } : { ok: false, names: [], error: geosite.error },
				geoip: geoip.names ? { ok: true, names: geoip.names } : { ok: false, names: [], error: geoip.error }
			};
		}
	},
	subscriptions: {
		call: function() {
			return command_json('/usr/sbin/steer subscription status');
		}
	},
	subscription_update: {
		call: function(request) {
			if (!request?.id)
				return { ok: false, error: '缺少订阅 ID' };
			return command_json([ '/usr/sbin/steer', 'subscription', 'update', '--id', request.id ]);
		}
	},
	subscription_clean: {
		call: function(request) {
			if (!request?.id || !request?.node)
				return { ok: false, error: '缺少订阅 ID 或节点 ID' };
			return command_json([ '/usr/sbin/steer', 'subscription', 'clean', '--id', request.id, '--node', request.node ]);
		}
	},
	node_speedtest: {
		call: function(request) {
			if (!request?.node)
				return { ok: false, error: '缺少节点 ID' };
			const command = [ '/usr/sbin/steer', 'probe', '--kind', 'speedtest', '--node', request.node ];
			if (request.download)
				command.push('--download');
			return command_json(command);
		}
	}
};

return { 'luci.steer': methods };
