# Maintainer: Shenghan Gao <gsh20040816 at gmail dot com>

pkgname=geoview
pkgver=0.2.6
pkgrel=1
pkgdesc='Tool to extract and convert GeoSite and GeoIP data'
arch=('x86_64' 'aarch64')
url='https://github.com/snowie2000/geoview'
# The 0.2.6 source archive does not declare an upstream license.
license=('unknown')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::https://codeload.github.com/snowie2000/$pkgname/tar.gz/refs/tags/$pkgver")
sha256sums=('1b46d4255ab22ec433a14f804e9487885cc2693323579c1385d51919838db132')

build() {
  cd "$pkgname-$pkgver"
  CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags='-s -w' \
    -o geoview \
    .
}

package() {
  install -Dm755 "$pkgname-$pkgver/geoview" "$pkgdir/usr/bin/geoview"
}
